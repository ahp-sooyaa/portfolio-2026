---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  handle: string;
  /** "" on the home page, "/" elsewhere, so anchors work from any page. */
  base?: string;
}

const { handle, base = "" } = Astro.props;

const links = [
  { href: "#work", label: "01 Work" },
  { href: "#experience", label: "02 Experience" },
  { href: "#stack", label: "03 Stack" },
];
---

<header class="relative top-0 z-10 sm:sticky border-b border-line bg-header backdrop-blur-md">
  <nav
    aria-label="Primary"
    class="container-page flex min-h-[68px] flex-wrap items-center justify-between gap-x-6 gap-y-3 py-2"
  >
    <a
      href={`${base}#top`}
      class="flex items-center gap-2.5 font-display text-xl font-extrabold tracking-[-0.02em] no-underline"
    >
      <span
        aria-hidden="true"
        class="inline-flex size-8 items-center justify-center rounded-lg bg-accent text-[15px] text-on-accent">A</span
      >
      <span>{handle}</span>
    </a>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-1 font-mono text-[13px]">
      {
        links.map((link) => (
          <a href={`${base}${link.href}`} class="py-3 text-muted no-underline transition-colors hover:text-ink">
            {link.label}
          </a>
        ))
      }
      <a
        href={`${base}#contact`}
        class="rounded-full bg-accent px-4 py-2.5 font-medium text-on-accent no-underline transition-[filter] hover:brightness-105"
        >Say hello</a
      >
      <ThemeToggle />
    </div>
  </nav>
</header>
