---
import type { CollectionEntry } from "astro:content";
import FeaturedProject from "./FeaturedProject.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  heading: string;
  intro: string;
  projects: CollectionEntry<"projects">[];
}

const { heading, intro, projects } = Astro.props;

const featured = projects.filter((p) => p.data.featured);
const cards = projects.filter((p) => !p.data.featured && p.data.layout === "card");
const rows = projects.filter((p) => !p.data.featured && p.data.layout === "list");
---

<section id="work" aria-labelledby="work-heading" class="container-page flex flex-col gap-12 pt-20 pb-12 sm:pt-28">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-3">
      <span class="font-mono text-[13px] text-accent-ink">01 / Selected work</span>
      <h2 id="work-heading" class="section-heading">{heading}</h2>
    </div>
    <p class="m-0 max-w-[380px] text-muted">{intro}</p>
  </div>

  {featured.map((project) => <FeaturedProject project={project} />)}

  {
    cards.length > 0 && (
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-5 p-0">
        {cards.map(({ data }) => (
          <li class="flex flex-col gap-4 rounded-[20px] border border-line-2 bg-surface p-8">
            <p class="m-0 font-mono text-xs text-subtle">
              <span class="sr-only">Built with </span>
              {data.tags.join(" · ")}
            </p>
            <h3 class="m-0 font-display text-[28px] leading-[1.1] font-semibold tracking-[-0.02em]">{data.title}</h3>
            <p class="m-0 flex-1 text-ink-4">{data.summary}</p>
            <ProjectLinks title={data.title} liveUrl={data.liveUrl} repoUrl={data.repoUrl} />
          </li>
        ))}
      </ul>
    )
  }

  {
    rows.length > 0 && (
      <div class="flex flex-col border-t border-line">
        <h3 class="eyebrow m-0 pt-6 pb-2 font-normal">More experiments</h3>
        <ul class="m-0 list-none p-0">
          {rows.map(({ data }) => (
            <li class="border-b border-line">
              <a
                href={data.liveUrl ?? data.repoUrl}
                class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5 no-underline"
              >
                <span class="font-display text-[22px] font-semibold transition-colors group-hover:text-accent-ink">
                  {data.title}
                </span>
                <span class="font-mono text-[13px] text-muted">{data.tags.join(" · ")}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
