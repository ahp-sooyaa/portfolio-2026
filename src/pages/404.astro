---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Arrow from "../components/Arrow.astro";
import { getProfile } from "../lib/site";

const profile = await getProfile();
---

<BaseLayout title={`Page not found — ${profile.name}`} noindex>
  <Header handle={profile.handle} base="/" />
  <main id="main" class="container-page flex min-h-[70vh] flex-col justify-center gap-8 py-24">
    <span class="font-mono text-[13px] text-accent-ink">404 / Not found</span>
    <h1
      class="m-0 font-display text-[clamp(48px,9vw,128px)] leading-[0.9] font-extrabold tracking-[-0.045em] text-balance"
    >
      Nothing <span class="text-accent-ink">here.</span>
    </h1>
    <p class="m-0 max-w-[520px] text-[clamp(18px,2vw,22px)] text-ink-2">
      This page doesn't exist, or it moved when the site was rebuilt.
    </p>
    <a
      href="/"
      class="inline-flex min-h-[52px] items-center gap-2.5 self-start rounded-full bg-accent px-6 font-semibold text-on-accent no-underline transition-[filter] hover:brightness-105"
    >
      Back to the home page
      <Arrow direction="right" />
    </a>
  </main>
  <Footer name={profile.name} base="/" />
</BaseLayout>
