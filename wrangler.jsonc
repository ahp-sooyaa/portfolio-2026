{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aunghtetpaing",
  "compatibility_date": "2026-10-19",
  // Pure static site: no Worker script, Cloudflare serves ./dist directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // Custom domain: uncomment after the domain's zone is on your Cloudflare account.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }]
}
